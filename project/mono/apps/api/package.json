{
	"name": "api",
	"version": "1.0.50",
	"scripts": {
		"test": "echo \"Error: no test specified\" && exit 1",
		"dev": "bun run --watch src/index.ts",
		"build": "bun build  --compile  --minify-whitespace --minify-syntax --target bun --outfile server-binary ./src/index.ts",
		"preview": "chmod +x ./server && ./server",
		"db:migration:run": "bun run src/db/migrate.ts",
		"db:migration:generate": "bunx drizzle-kit generate"
	},
	"dependencies": {
		"@elysiajs/cors": "^1.3.1",
		"@elysiajs/eden": "^1.3.2",
		"@elysiajs/swagger": "^1.3.0",
		"drizzle-orm": "^0.43.1",
		"drizzle-typebox": "^0.3.2",
		"elysia": "latest"
	},
	"devDependencies": {
		"bun-types": "latest",
		"drizzle-kit": "^0.31.1"
	},
	"module": "src/index.js"
}
